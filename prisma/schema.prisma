/// Ver changelog punto 89 (flujo de pago real del Plan Pro, pasarela SPIDI).
enum ProveedorPago {
  SPIDI
}

/// ACTIVA: cobro al día. PENDIENTE_PAGO: venció y no se pudo renovar —
/// todavía no se baja a FICHA sola (da un margen de gracia antes de
/// degradar). BAJANDO_A_FICHA: el médico pidió la baja, sigue en PRO hasta
/// `finPeriodoActual`. SIN_METODO_DE_PAGO: eligió PRO pero nunca completó
/// el pago inicial. PENDIENTE_CONFIRMACION: el médico dijo "ya pagué" en
/// SPIDI y queda un `Pago` en PENDIENTE hasta que alguien del equipo lo
/// confirme a mano — ver changelog punto 89 (sin cuenta comercial en
/// SPIDI no hay API ni webhook; el cobro pasa por SPIDI, la confirmación
/// es manual).
enum EstadoSuscripcion {
  /// Mes gratis del plan Ficha corriendo: `finPeriodoActual` dice cuándo
  /// termina. No corta nada al vencer — el OS avisa y la cobranza se hace
  /// a mano (decisión del founder, 13-nov-2026).
  PRUEBA
  ACTIVA
  /// Cortesía: la cuenta no vence y no se le cobra (decisión del founder,
  /// 13-nov-2026, a propósito de la Dra. Yamaruc). El OS no le muestra
  /// recordatorio de pago y su ficha del Directorio nunca se corta.
  CORTESIA
  PENDIENTE_PAGO
  BAJANDO_A_FICHA
  SIN_METODO_DE_PAGO
  PENDIENTE_CONFIRMACION
}

enum EstadoPago {
  PAGADO
  FALLIDO
  PENDIENTE
}

/// Estado de la suscripción al Plan Pro — 1:1 con Organizacion. No existe
/// fila para organizaciones que siempre estuvieron en Ficha sin intentar
/// subir de plan nunca; `obtenerSuscripcion()` sintetiza ese caso (ver
/// src/modules/suscripcion/obtenerSuscripcion.ts) en vez de forzar un
/// backfill — evita una migración de datos que no cambia ningún
/// comportamiento.
model Suscripcion {
  id                  String             @id @default(cuid())
  organizacionId      String             @unique
  proveedor           ProveedorPago      @default(SPIDI)
  estado              EstadoSuscripcion  @default(SIN_METODO_DE_PAGO)
  /// A qué plan vuelve Organizacion.plan al llegar `finPeriodoActual` — null
  /// significa "se renueva igual". Es lo único que cambia una baja: no hay
  /// corte inmediato (DECISIÓN pendiente de confirmar con el usuario, ver
  /// changelog punto 89 — asumido "al final del periodo pagado" por falta
  /// de respuesta explícita).
  planAlRenovar       PlanOrganizacion?
  inicioPeriodoActual DateTime?
  finPeriodoActual    DateTime?
  /// Sin uso por ahora: la cuenta de SPIDI del usuario es personal, no
  /// comercial, y el API (donde existirían estos ids) es solo para cuentas
  /// comerciales — ver changelog punto 89. Quedan por si en algún momento
  /// se abre cuenta comercial y vale la pena automatizar esto de verdad.
  spidiClienteId      String?
  spidiSuscripcionId  String?
  /// Sin uso por ahora, mismo motivo — no hay API para consultarlo.
  metodoPagoResumen   String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  organizacion        Organizacion       @relation(fields: [organizacionId], references: [id])
  pagos               Pago[]

  @@map("suscripciones")
}

/// Historial de cobros — la sección "Facturas" de /ajustes. Una fila por
/// intento real de pago: la crea el médico al decir "ya pagué" (estado
/// PENDIENTE) y la confirma alguien del equipo a mano en /superadmin/pagos
/// (PAGADO/FALLIDO) — no hay webhook de SPIDI que lo haga solo (cuenta
/// personal, sin API). Ver changelog punto 89.
model Pago {
  id             String       @id @default(cuid())
  organizacionId String
  suscripcionId  String
  plan           PlanOrganizacion
  montoCentavos  Int
  moneda         String       @default("USD")
  estado         EstadoPago
  spidiPagoId    String?      @unique
  fecha          DateTime     @default(now())
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])
  suscripcion    Suscripcion  @relation(fields: [suscripcionId], references: [id])
  // 10-nov-2026: antes el médico mandaba la captura del comprobante por
  // WhatsApp aparte ("no por whatsapp aca dentro" — pedido explícito del
  // usuario). Ahora se adjunta en el mismo formulario de "Ya pagué" y
  // queda guardada acá para que /superadmin/pagos la muestre directo, sin
  // depender de un canal externo. Bytes en la propia fila (no un bucket
  // de storage aparte): el volumen es bajo (un comprobante por pago,
  // revisado a mano una sola vez) y evita sumar infraestructura nueva para
  // esto. `comprobanteTipo` guarda el content-type real del archivo que
  // subió el médico (image/png, image/jpeg, etc.) para poder re-servirlo
  // con el tipo correcto.
  comprobante     Bytes?
  comprobanteTipo String?

  @@index([organizacionId, fecha])
  @@map("pagos")
}

