generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Tenant raíz: consultorio o clínica.
model Organizacion {
  id                    String                   @id @default(cuid())
  nombre                String
  /// Catálogo cerrado — ver changelog punto 23 (paywall) y punto 49 (registro
  /// real). Se fija FICHA por defecto; PRO solo si la profesión del médico
  /// está en el catálogo elegible (ver `PROFESIONES_ELEGIBLES_PRO`).
  plan                  PlanOrganizacion         @default(FICHA)
  /// Vínculo con la ficha pública en el Directorio (conxulty.com,
  /// repo `vitalud`, tabla `profesionales`) — ver changelog punto 75.
  /// Null = todavía no sincronizada nunca (registro falló o es anterior
  /// a esta integración). Se llena con el `id` que devuelve el endpoint
  /// `POST /api/sincronizar-profesional` del Directorio.
  fichaDirectorioId          String?  @unique
  /// Slug público de la ficha en el Directorio (conxulty.com/medico/<slug>),
  /// cacheado acá para no depender de una llamada extra solo para armar el
  /// link "Ver mi ficha pública" en el sidebar.
  fichaDirectorioSlug        String?
  /// true solo después de una sincronización exitosa — si el registro creó
  /// la Organizacion pero la llamada al Directorio falló (ver registro.ts),
  /// queda en false y "Mi ficha pública" ofrece reintentar.
  fichaDirectorioSincronizada Boolean @default(false)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  antecedentesMedicos   AntecedenteMedico[]
  cajas                 Caja[]
  citas                 Cita[]
  cobros                Cobro[]
  consultas             Consulta[]
  documentos            Documento[]
  entidades             Entidad[]
  gastos                Gasto[]
  medicos               Medico[]
  movimientosCaja       MovimientoCaja[]
  pacientes             Paciente[]
  pagos                 Pago[]
  registrosTrazabilidad RegistroTrazabilidad[]
  sedes                 Sede[]
  suscripcion           Suscripcion?
  usuarios              Usuario[]

  @@map("organizaciones")
}

/// Cuenta con la que se inicia sesión. Puede tener un perfil Medico asociado.
model Usuario {
  id                     String                 @id @default(cuid())
  organizacionId         String
  nombre                 String
  email                  String                 @unique
  passwordHash           String
  rol                    RolUsuario             @default(MEDICO)
  activo                    Boolean                  @default(true)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  cajasAbiertas             Caja[]                   @relation("CajaAbiertaPor")
  entidad                   Entidad?
  gastosRegistrados         Gasto[]                  @relation("GastoRegistradoPor")
  medico                    Medico?
  movimientosRegistrados    MovimientoCaja[]         @relation("MovimientoRegistradoPor")
  registrosTrazabilidad     RegistroTrazabilidad[]   @relation("TrazabilidadActor")
  organizacion              Organizacion             @relation(fields: [organizacionId], references: [id])
  tokensRecuperacion        TokenRecuperacion[]

  @@index([organizacionId])
  @@map("usuarios")
}

/// "Olvidé mi contraseña" (10-nov-2026, pedido del usuario: "falta olvide
/// usuario y olvide contraseña" — el login es por correo, no hay un
/// "usuario" separado que recuperar, así que esto cubre solo contraseña).
/// Token de un solo uso, vida corta. 12-nov-2026 (auditoría, hallazgo C1):
/// la columna `token` guarda el SHA-256 del token, nunca el token en claro
/// — el valor real solo viaja en el link del correo. Así, leer esta tabla
/// no alcanza para restablecer la contraseña de nadie. Se reemplaza/borra
/// por completo en cada pedido nuevo del mismo usuario, no se acumulan
/// tokens viejos sin usar.
model TokenRecuperacion {
  id         String   @id @default(cuid())
  usuarioId  String
  token      String   @unique
  expiraEn   DateTime
  usado      Boolean  @default(false)
  createdAt  DateTime @default(now())
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("tokens_recuperacion")
}

/// Intentos fallidos de inicio de sesión (12-nov-2026, auditoría, hallazgo
/// A3) — sin esto el login no tenía ningún freno contra probar contraseñas
/// en serie. `clave` es el correo en minúsculas (exista o no la cuenta:
/// registrar solo los que existen revelaría cuáles correos están
/// registrados). Ver src/modules/acceso/intentos.ts.
///
/// OJO al crear tablas nuevas: Supabase expone todo `public` por su API
/// REST — toda migración que cree una tabla debe terminar con
/// `ENABLE ROW LEVEL SECURITY` (ver la migración de esta tabla).
model IntentoAcceso {
  id        String   @id @default(cuid())
  clave     String
  createdAt DateTime @default(now())

  @@index([clave, createdAt])
  @@map("intentos_acceso")
}

/// Perfil de clínica o farmacia (changelog punto 90/92) — equivalente de
/// `Medico` para el rol ENTIDAD, deliberadamente sin nada de agenda/citas:
/// esa es justo la diferencia de producto con un médico. `horario` es el
/// horario regular (mismo formato que `Sede.horario`, 7 entradas
/// {dia,atiende,horaInicio,horaFin}); `horarioTurno` es exclusivo de
/// FARMACIA (mismo formato) — la UI para editarlo llega en una tarea
/// aparte, la columna se crea ahora para no migrar dos veces.
model Entidad {
  id             String      @id @default(cuid())
  usuarioId      String      @unique
  organizacionId String
  tipo           TipoEntidad
  /// Catálogo cerrado de municipios de Trujillo, mismo que `Sede.municipio`
  /// — una entidad tiene UNA sola ubicación (a diferencia del médico, que
  /// puede tener varias sedes).
  municipio      String?
  direccion      String?
  telefono       String?
  horario        Json        @default("[]")
  /// Solo tiene sentido si `tipo` = FARMACIA — nadie valida que una
  /// CLINICA lo deje vacío, simplemente la UI no se lo pide.
  horarioTurno   Json        @default("[]")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])
  usuario        Usuario      @relation(fields: [usuarioId], references: [id])

  @@index([organizacionId])
  @@map("entidades")
}

/// Perfil profesional del médico: lo que lo identifica en agenda, consulta y documentos.
/// Campos de registro (profesion, cedula, numeroMpps, especialidadesSecundarias,
/// modalidades, zonasCobertura) vienen del onboarding real — ver changelog
/// punto 49 (Bloque 3). `especialidad` sigue siendo la principal (texto libre,
/// sin catálogo cerrado — eso es solo para Plantillas de Consulta, punto 37).
model Medico {
  id                      String                 @id @default(cuid())
  usuarioId               String                 @unique
  organizacionId          String
  especialidad            String?
  numeroColegiado         String?
  /// Catálogo cerrado — ver changelog punto 49. Determina si se ofrece Plan Pro.
  profesion               Profesion              @default(MEDICO)
  /// Solo informado cuando `profesion` = OTRA.
  profesionOtraTexto      String?
  cedula                  String?
  /// Solo aplica si `profesion` = MEDICO (ver changelog punto 29).
  numeroMpps              String?
  /// WhatsApp público del médico (Directorio) — 10-nov-2026, "el único
  /// teléfono que se debe pedir y existir es el whatsapp del médico, no
  /// uno para cada sede": antes `Sede.telefono` se pedía por sede (varias
  /// sedes de un mismo médico podían terminar con números distintos o
  /// repetidos sin necesidad — es la misma persona contestando). Ahora
  /// vive acá, una sola vez, y se manda igual (fanned out) a cada sede en
  /// el sync con el Directorio para no tocar su esquema/gateo por sede.
  telefonoPublico         String?
  especialidadesSecundarias String[]             @default([])
  /// Catálogo cerrado, multi-select — ver changelog punto 30 (addendum).
  modalidades             ModalidadAtencion[]    @default([])
  /// Municipios de Trujillo (catálogo cerrado) — solo relevante si
  /// `modalidades` incluye DOMICILIO. Ver changelog puntos 26/32.
  zonasCobertura          String[]               @default([])
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  antecedentesMedicos     AntecedenteMedico[]
  citas                   Cita[]
  cobros                  Cobro[]
  consultas               Consulta[]
  documentos              Documento[]
  sedes                   Sede[]
  organizacion            Organizacion           @relation(fields: [organizacionId], references: [id])
  usuario                 Usuario                @relation(fields: [usuarioId], references: [id])

  @@index([organizacionId])
  @@map("medicos")
}

/// Lugar físico donde atiende un médico (solo aplica si sus `modalidades`
/// incluyen PRESENCIAL) — ver changelog puntos 25/27/33. Un médico puede
/// tener varias; relación 1:N desde Medico, no N:N (resuelve la pregunta
/// abierta del punto 22/25: en este producto una sede es de un solo médico).
model Sede {
  id             String       @id @default(cuid())
  medicoId       String
  organizacionId String
  /// Catálogo cerrado de municipios de Trujillo — ver changelog puntos 26/32.
  municipio      String
  direccion      String
  referencia     String?
  /// Array de 7 entradas { dia, atiende, horaInicio, horaFin } — ver
  /// changelog punto 33. Se guarda como JSON (no una tabla aparte) porque
  /// el choque de horario entre sedes se calcula en la app, no con un query.
  horario        Json         @default("[]")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  medico         Medico       @relation(fields: [medicoId], references: [id])
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])

  @@index([medicoId])
  @@index([organizacionId])
  @@map("sedes")
}

model Paciente {
  id                         String              @id @default(cuid())
  organizacionId             String
  nombre                     String
  apellido                   String
  fechaNacimiento            DateTime?
  sexo                       String?
  telefono                   String?
  email                      String?
  /// Cédula/DNI/pasaporte. Único por organización, nunca globalmente — dos
  /// organizaciones distintas pueden tener cada una un paciente con el mismo
  /// documento sin que choquen entre sí (ver @@unique más abajo).
  documentoIdentidad         String?
  direccion                  String?
  contactoEmergenciaNombre   String?
  contactoEmergenciaTelefono String?
  /// Archivado lógico: un paciente nunca se borra, se desactiva. Las citas,
  /// consultas y cobros ya existentes se conservan intactos.
  activo                     Boolean             @default(true)
  /// Odontograma — ver changelog punto 51. Mapa { "11": "CARIES", ... },
  /// FDI de 2 dígitos como clave; un diente ausente del mapa es SANO
  /// implícito (no se guarda el estado por defecto). Vive en Paciente, no
  /// en Consulta: es el estado ACTUAL de la boca, no una foto de una
  /// visita — se actualiza, no se acumula visita a visita. Solo lo usa/ve
  /// un médico con profesión ODONTOLOGO (gating en la app, no en el
  /// esquema — cualquier Paciente puede tenerlo si alguna vez cambia de
  /// consultorio).
  odontograma                Json?
  /// Nota general del odontograma (ver changelog punto 51b) — texto libre,
  /// una sola nota por paciente, no por diente (no se pidió detalle por
  /// pieza y hubiera complicado el diagrama). Se guarda y edita junto con
  /// el mapa de dientes, en el mismo formulario y la misma acción.
  notasOdontograma           String?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  antecedentesMedicos        AntecedenteMedico[]
  citas                      Cita[]
  cobros                     Cobro[]
  consultas                  Consulta[]
  organizacion               Organizacion        @relation(fields: [organizacionId], references: [id])

  @@unique([organizacionId, documentoIdentidad])
  @@index([organizacionId])
  @@index([organizacionId, activo])
  @@map("pacientes")
}

/// Información clínica persistente del paciente (alergias, enfermedades
/// crónicas, cirugías, medicación habitual, hábitos, antecedentes personales
/// y familiares, observaciones) — distinta de `Consulta.antecedentes`, que es
/// lo documentado durante un episodio puntual. Un AntecedenteMedico se
/// consulta ANTES de futuras consultas (p.ej. alertar alergias); nunca se
/// edita in-place una vez creado, para no perder el registro de qué se supo
/// y cuándo — una corrección se hace desactivando el registro (`activo =
/// false`) y creando uno nuevo, mismo criterio que Documento con la
/// inmutabilidad clínica.
model AntecedenteMedico {
  id             String          @id @default(cuid())
  organizacionId String
  pacienteId     String
  medicoId       String
  tipo           TipoAntecedente
  descripcion    String
  activo         Boolean         @default(true)
  fecha          DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  medico         Medico          @relation(fields: [medicoId], references: [id])
  organizacion   Organizacion    @relation(fields: [organizacionId], references: [id])
  paciente       Paciente        @relation(fields: [pacienteId], references: [id])

  @@index([organizacionId, pacienteId])
  @@map("antecedentes_medicos")
}

model Cita {
  id              String        @id @default(cuid())
  organizacionId  String
  pacienteId      String
  medicoId        String
  fechaHora       DateTime
  duracionMinutos Int           @default(30)
  modalidad       ModalidadCita @default(PRESENCIAL)
  estado          EstadoCita    @default(PENDIENTE)
  motivo          String?
  /// Notas operativas de agenda (p.ej. "confirmar por teléfono"). Nunca
  /// contenido clínico: eso vive exclusivamente en Consulta.
  notas           String?
  /// Task #15 (changelog punto 91/97): de dónde vino la cita — OS (el
  /// médico/su staff la cargó desde la agenda) o DIRECTORIO (un paciente
  /// la reservó desde la ficha pública en conxulty.com). Sirve para que
  /// la agenda distinga cuáles vienen de afuera y necesitan revisión
  /// prioritaria — no cambia ninguna regla de negocio por sí solo.
  origen          CitaOrigen    @default(OS)
  /// Task #16 (changelog punto 91/98): token de un solo uso que habilita
  /// dejar una reseña pública de ESTA cita. Solo se genera para citas
  /// origen DIRECTORIO (ver citasPublicas.ts) — pedido explícito del
  /// usuario: "quien las deja: solo quien reserve una cita por medio de
  /// conxulty". Una cita cargada desde la agenda del OS no tiene token,
  /// nunca habilita reseña. No se borra al usarse — `tokenResenaUsado`
  /// es lo que lo invalida, así queda trazabilidad de qué reseña vino
  /// de qué cita.
  tokenResena       String?     @unique
  tokenResenaUsado  Boolean     @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  medico          Medico        @relation(fields: [medicoId], references: [id])
  organizacion    Organizacion  @relation(fields: [organizacionId], references: [id])
  paciente        Paciente      @relation(fields: [pacienteId], references: [id])
  consulta        Consulta?

  @@index([organizacionId, fechaHora])
  @@map("citas")
}

/// Núcleo operativo: conecta Paciente -> Cita -> Consulta y de aquí cuelgan
/// documentos y cobros, evitando que el médico repita información.
model Consulta {
  id             String         @id @default(cuid())
  organizacionId String
  pacienteId     String
  medicoId       String
  citaId         String?        @unique
  motivoConsulta String?
  anamnesis      String?
  antecedentes   String?
  examenFisico   String?
  evaluacion     String?
  diagnostico    String?
  tratamiento    String?
  /// Signos vitales de ESTA consulta (29-oct-2026 — ver changelog de la
  /// demo, punto 6, y la DECISIÓN del usuario de llevarlos al esquema real
  /// en vez de dejarlos como UI sin dato). Van en Consulta, no en Paciente:
  /// son una medición puntual del momento de la visita, no un atributo fijo
  /// del paciente. `presionArterial` queda como texto libre
  /// ("120/80 mmHg") en vez de dos enteros separados — distintos
  /// consultorios anotan presión con formatos distintos (con/sin unidad,
  /// con notas como "sentado"), y forzar systólica/diastólica como enteros
  /// perdería esa flexibilidad sin ganar nada que hoy se necesite calcular.
  /// El IMC NO se guarda: se calcula en la UI a partir de peso/talla
  /// cuando ambos están presentes, para no duplicar un valor derivado que
  /// puede desincronizarse (mismo criterio que ya se usó para no guardar
  /// "vs. ayer" en los KPIs de Hoy).
  presionArterial    String?
  frecuenciaCardiaca Int?
  /// Grados Celsius.
  temperatura        Decimal? @db.Decimal(4, 1)
  /// % de saturación de oxígeno (SpO₂).
  saturacionOxigeno  Int?
  pesoKg             Decimal? @db.Decimal(5, 2)
  tallaCm            Decimal? @db.Decimal(5, 1)
  /// Campos adicionales de la "Plantilla por especialidad" — ver changelog
  /// puntos 37-40/49. Mapa { campoId: valorTexto }, resuelto en la app por
  /// `resolverPlantilla()` según la profesión/especialidad del médico, no
  /// una tabla con columnas fijas (el catálogo puede crecer sin migración).
  /// Nullable, opcional — nunca requerido para guardar/cerrar una consulta.
  camposEspecialidad Json?
  estado         EstadoConsulta @default(EN_CURSO)
  fechaHora      DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  cobros         Cobro[]
  cita           Cita?          @relation(fields: [citaId], references: [id], onDelete: Restrict)
  medico         Medico         @relation(fields: [medicoId], references: [id])
  organizacion   Organizacion   @relation(fields: [organizacionId], references: [id])
  paciente       Paciente       @relation(fields: [pacienteId], references: [id])
  documentos     Documento[]

  @@index([organizacionId, pacienteId])
  @@map("consultas")
}

/// Documento clínico inmutable emitido desde una Consulta (receta; en el
/// futuro informe/constancia/orden — agregar el valor al enum no requiere
/// rediseñar este modelo). Una vez creado nunca se edita: un error se
/// corrige emitiendo un documento nuevo, no modificando el existente — por
/// eso no tiene updatedAt, y fechaEmision (siempre server-side, nunca
/// enviada por el cliente) es su único timestamp relevante.
///
/// `contenido` es JSON porque su forma depende de `tipo`: una receta es una
/// lista de medicamentos, un futuro informe sería texto libre — evita tener
/// que crear una tabla nueva por cada tipo de documento. No lleva
/// pacienteId propio: se deriva de consulta.pacienteId (relación real, no
/// opcional) para no duplicar un dato que ya vive en el schema.
model Documento {
  id             String        @id @default(cuid())
  organizacionId String
  consultaId     String
  medicoId       String
  tipo           TipoDocumento
  contenido      Json
  fechaEmision   DateTime      @default(now())
  consulta       Consulta      @relation(fields: [consultaId], references: [id])
  medico         Medico        @relation(fields: [medicoId], references: [id])
  organizacion   Organizacion  @relation(fields: [organizacionId], references: [id])

  @@index([organizacionId, consultaId])
  @@map("documentos")
}

/// Obligación/pago de un paciente, opcionalmente asociado a una consulta. Una
/// consulta puede tener 0, 1 o varios cobros (cobro posterior, pagos
/// parciales, distintos conceptos, consulta de cortesía sin cobro). También
/// puede no haber consulta en absoluto ("cobro rápido": venta de un
/// producto, un abono suelto) — en ese caso `concepto` es obligatorio a
/// nivel de aplicación (no de constraint de DB, mismo criterio que `nota` en
/// Gasto) para que el cobro tenga un texto descriptivo en el reporte de
/// caja; cuando sí hay consulta, la consulta ya da el contexto y `concepto`
/// queda opcional.
model Cobro {
  id              String           @id @default(cuid())
  organizacionId  String
  /// Folio correlativo para el comprobante (ver changelog punto 13/48):
  /// "COB-" + este número, con ceros a la izquierda. Es global, no por
  /// organización — Prisma/Postgres no dan un autoincrement scoped sin
  /// una secuencia manual, y un folio que salta entre organizaciones no
  /// es un problema real (cada organización ve su propio folio, nunca
  /// compara el número con el de otra).
  numero          Int              @unique @default(autoincrement())
  consultaId      String?
  pacienteId      String
  medicoId        String
  concepto        String?
  monto           Decimal          @db.Decimal(10, 2)
  /// Descuento/cortesía aplicado (ver changelog punto 13/48): `monto` ya
  /// es el total neto cobrado (igual significado que antes, no cambia
  /// nada de lo que ya depende de `monto` — arqueo, reportes). El
  /// subtotal "de lista" para el comprobante se deriva como
  /// `monto + descuentoMonto`, nunca al revés. `descuentoMotivo` es
  /// obligatorio en código (no constraint de DB, mismo criterio que
  /// `concepto` en cobro sin consulta) cuando `descuentoMonto > 0`.
  descuentoMonto  Decimal          @default(0) @db.Decimal(10, 2)
  descuentoMotivo String?
  /// `moneda` y `esEfectivo` quedan denormalizados a partir de
  /// `metodoPago` (ver changelog punto 11/46) — nunca se piden por
  /// separado en el formulario, se derivan en registrarCobro() desde
  /// `INFO_METODO_PAGO` para que no puedan contradecirse.
  moneda          String           @default("USD")
  esEfectivo      Boolean          @default(true)
  /// Catálogo cerrado (antes texto libre) — ver changelog punto 11/46.
  /// El `@default` es solo para que `db push` pueda rellenar filas de
  /// prueba ya existentes sin pedir --force-reset; el código de la app
  /// (registrarCobro()) siempre manda un valor explícito, nunca confía
  /// en este default.
  metodoPago      MetodoPago       @default(EFECTIVO_USD)
  estado          EstadoCobro      @default(PENDIENTE)
  fecha           DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  consulta        Consulta?        @relation(fields: [consultaId], references: [id], onDelete: Restrict)
  medico          Medico           @relation(fields: [medicoId], references: [id])
  organizacion    Organizacion     @relation(fields: [organizacionId], references: [id])
  paciente        Paciente         @relation(fields: [pacienteId], references: [id])
  movimientosCaja MovimientoCaja[]

  @@index([organizacionId, consultaId])
  @@map("cobros")
}

/// Arqueo al cierre: montoEsperado se calcula desde MovimientoCaja (nunca se
/// edita a mano) y queda congelado en este campo; montoContado es lo que la
/// persona contó físicamente (obligatorio para cerrar); diferencia = contado
/// - esperado, se guarda siempre — si no cuadra, queda registrada y visible,
/// nunca se oculta ajustando montoEsperado.
/// Campos de arqueo DUPLICADOS por moneda (29-oct-2026 — ver changelog
/// punto 46: el cálculo anterior sumaba USD y Bs entre sí, y contaba
/// métodos no-efectivo como si fueran plata física. El arqueo de verdad
/// solo le importa al EFECTIVO, y nunca hay que sumar monedas distintas
/// — por eso dos columnas por concepto (`*Usd`/`*Bs`) en vez de una sola
/// genérica. No es un catálogo de 6 métodos de pago (eso sigue pendiente,
/// ver Caja 10-15 en el changelog de la demo) — es lo mínimo para que el
/// arqueo de efectivo deje de estar mal.
model Caja {
  id              String           @id @default(cuid())
  organizacionId  String
  abiertaPorId    String
  fechaApertura   DateTime         @default(now())
  fechaCierre     DateTime?
  montoInicialUsd Decimal          @default(0) @db.Decimal(10, 2)
  montoInicialBs  Decimal          @default(0) @db.Decimal(10, 2)
  montoContadoUsd Decimal?         @db.Decimal(10, 2)
  montoContadoBs  Decimal?         @db.Decimal(10, 2)
  montoEsperadoUsd Decimal?        @db.Decimal(10, 2)
  montoEsperadoBs Decimal?         @db.Decimal(10, 2)
  diferenciaUsd   Decimal?         @db.Decimal(10, 2)
  diferenciaBs    Decimal?         @db.Decimal(10, 2)
  estado         EstadoCaja       @default(ABIERTA)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  abiertaPor     Usuario          @relation("CajaAbiertaPor", fields: [abiertaPorId], references: [id])
  organizacion   Organizacion     @relation(fields: [organizacionId], references: [id])
  gastos         Gasto[]
  movimientos    MovimientoCaja[]

  @@index([organizacionId, estado])
  @@map("cajas")
}

/// Movimiento real de dinero en caja. Distinto de Cobro: un Cobro representa la
/// obligación/pago; el MovimientoCaja representa que el dinero efectivamente entró o salió.
///
/// Lleva organizacionId propio (denormalizado desde Caja.organizacionId) para que
/// cualquier repositorio pueda filtrar por organización directamente, sin depender
/// de un join a través de Caja. Ver src/db/consistenciaOrganizacional.ts, que valida
/// en tiempo de escritura que ambos valores coincidan.
model MovimientoCaja {
  id              String               @id @default(cuid())
  organizacionId  String
  cajaId          String
  cobroId         String?
  gastoId         String?
  tipo            TipoMovimientoCaja
  origen          OrigenMovimientoCaja @default(INGRESO_MANUAL)
  monto           Decimal              @db.Decimal(10, 2)
  moneda          String               @default("USD")
  /// Copiado del Cobro/Gasto de origen al crear el movimiento (mismo
  /// patrón que `moneda`, denormalizado para no tener que resolver el
  /// join al calcular el arqueo). Ver changelog punto 46.
  esEfectivo      Boolean              @default(true)
  /// Copiado del Cobro/Gasto de origen (ver changelog punto 11/46) —
  /// permite calcular "saldo en cuentas" por método agrupando solo
  /// MovimientoCaja, sin tener que resolver el join hacia Cobro/Gasto.
  /// `@default` solo para permitir el `db push` sobre filas de prueba
  /// existentes — ver nota en `Cobro.metodoPago`.
  metodoPago      MetodoPago           @default(EFECTIVO_USD)
  descripcion     String?
  registradoPorId String
  fecha           DateTime             @default(now())
  createdAt       DateTime             @default(now())
  caja            Caja                 @relation(fields: [cajaId], references: [id])
  cobro           Cobro?               @relation(fields: [cobroId], references: [id], onDelete: Restrict)
  gasto           Gasto?               @relation(fields: [gastoId], references: [id], onDelete: Restrict)
  organizacion    Organizacion         @relation(fields: [organizacionId], references: [id])
  registradoPor   Usuario              @relation("MovimientoRegistradoPor", fields: [registradoPorId], references: [id])

  @@index([organizacionId])
  @@index([cajaId])
  @@map("movimientos_caja")
}

/// Gasto operativo del consultorio (alquiler, insumos, personal, servicios),
/// registrado dentro de una Caja abierta. Igual que MovimientoCaja y
/// Documento, es un hecho financiero inmutable: no tiene updatedAt, una
/// corrección se hace con un movimiento nuevo, no editando este registro.
model Gasto {
  id              String           @id @default(cuid())
  organizacionId  String
  cajaId          String
  categoria       CategoriaGasto
  monto           Decimal          @db.Decimal(10, 2)
  /// `moneda` y `esEfectivo` quedan denormalizados a partir de
  /// `metodoPago` (ver changelog punto 11/46), igual que en Cobro.
  moneda          String           @default("USD")
  esEfectivo      Boolean          @default(true)
  /// Catálogo cerrado — ver changelog punto 11/46. Antes no existía
  /// ningún campo de método de pago en Gasto. `@default` solo para
  /// permitir el `db push` sobre filas de prueba existentes — ver nota
  /// en `Cobro.metodoPago`.
  metodoPago      MetodoPago       @default(EFECTIVO_USD)
  nota            String?
  registradoPorId String
  fecha           DateTime         @default(now())
  createdAt       DateTime         @default(now())
  caja            Caja             @relation(fields: [cajaId], references: [id])
  organizacion    Organizacion     @relation(fields: [organizacionId], references: [id])
  registradoPor   Usuario          @relation("GastoRegistradoPor", fields: [registradoPorId], references: [id])
  movimientosCaja MovimientoCaja[]

  @@index([organizacionId, cajaId])
  @@map("gastos")
}

/// Trazabilidad funcional (distinta de logs técnicos): quién hizo qué, sobre qué
/// entidad, cuándo y qué cambió. Pensada para consultorios/clínicas multiusuario.
model RegistroTrazabilidad {
  id             String       @id @default(cuid())
  organizacionId String
  actorId        String
  accion         String
  entidadTipo    String
  entidadId      String
  pacienteId     String?
  cambios        Json?
  fecha          DateTime     @default(now())
  actor          Usuario      @relation("TrazabilidadActor", fields: [actorId], references: [id])
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])

  @@index([organizacionId, entidadTipo, entidadId])
  @@index([organizacionId, pacienteId])
  @@map("registros_trazabilidad")
}

