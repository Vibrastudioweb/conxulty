# --- Supabase (API REST) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Prisma 7 + Supabase (PostgreSQL directo) ---
# DATABASE_URL: cadena del pooler de Supabase (puerto 6543).
#   Formato: postgresql://usuario:password@host.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=

# DIRECT_URL: cadena directa de Supabase (puerto 5432, sin pgbouncer).
#   Formato: postgresql://usuario:password@host.pooler.supabase.com:5432/postgres
DIRECT_URL=

# --- NextAuth v5 ---
# AUTH_SECRET: clave de firma de sesiones JWT.
#   Genera uno con: openssl rand -base64 32
AUTH_SECRET=
