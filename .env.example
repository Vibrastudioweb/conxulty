NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Prisma 7 + Supabase (PostgreSQL directo)
# DATABASE_URL  -> cadena del pooler (puerto 6543), con ?pgbouncer=true&connection_limit=1
# DIRECT_URL    -> cadena directa (puerto 5432), sin pgbouncer
DATABASE_URL=
DIRECT_URL=

# NextAuth v5 (AUTH_SECRET)
# Genera uno con: openssl rand -base64 32
AUTH_SECRET=
